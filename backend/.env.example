# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Add backend environment variables here.
# Example:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

SUPABASE_MEDICAL_REPORTS_BUCKET=medical-reports

# Set true only for demo/testing; values are simulated and never read from the uploaded report.
PRANA_DEMO_OCR=false
